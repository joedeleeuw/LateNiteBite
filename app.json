{
  "expo": {
    "name": "Late Nite Bite",
    "slug": "latenitebite",
    "owner": "sleepernet",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "latenitebite",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joedeleeuw.latenitebite",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.joedeleeuw.latenitebite",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A101C"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "sleeper",
          "project": "latenitebite",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "uploadNativeSymbols": true,
            "autoUploadNativeSymbols": true,
            "includeNativeSources": true,
            "includeProguardMapping": true,
            "autoUploadProguardMapping": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A101C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A101C"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Late Nite Bite uses your location to show what is open right now near you."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "inlineModules": {
        "watchedDirectories": [
          "native"
        ]
      },
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d70a66b1-351f-4cb7-9b43-0838417341b9"
      }
    }
  }
}
