{
  "name": "latenitebite",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild:native": "expo prebuild --clean",
    "build:android": "scripts/android-env.sh pnpm dlx eas-cli@20.4.0 eas build --platform android --profile production --local --non-interactive",
    "build": "expo export --platform web",
    "assets": "node scripts/generate-mark.mjs && node scripts/render-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "vitest run",
    "smoke:android:doctor": "scripts/smoke-android.sh --doctor",
    "smoke:android": "scripts/smoke-android.sh .maestro/android-location-required.yaml",
    "smoke:android:live": "scripts/smoke-android.sh .maestro/android-right-now-live.yaml",
    "smoke:ios:doctor": "scripts/smoke-ios.sh --doctor",
    "smoke:ios": "scripts/smoke-ios.sh .maestro/ios-location-required.yaml",
    "smoke:ios:live": "scripts/smoke-ios.sh .maestro/ios-right-now-live.yaml"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:expo56",
    "@legendapp/list": "catalog:",
    "@sentry/react-native": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query": "catalog:",
    "expo": "catalog:expo56",
    "expo-constants": "catalog:expo56",
    "expo-glass-effect": "catalog:expo56",
    "expo-haptics": "catalog:expo56",
    "expo-image": "catalog:expo56",
    "expo-linking": "catalog:expo56",
    "expo-location": "catalog:expo56",
    "expo-router": "catalog:expo56",
    "expo-splash-screen": "catalog:expo56",
    "expo-status-bar": "catalog:expo56",
    "expo-system-ui": "catalog:expo56",
    "lightningcss": "catalog:",
    "opening_hours": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "catalog:expo56",
    "react-native-gesture-handler": "catalog:expo56",
    "react-native-reanimated": "catalog:expo56",
    "react-native-safe-area-context": "catalog:expo56",
    "react-native-screens": "catalog:expo56",
    "react-native-svg": "catalog:expo56",
    "react-native-web": "catalog:expo56",
    "react-native-worklets": "catalog:expo56",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:",
    "zod": "catalog:"
