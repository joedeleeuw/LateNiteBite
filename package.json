  "devDependencies": {
    "@babel/preset-typescript": "catalog:expo56",
    "@types/react": "catalog:react19",
    "babel-preset-expo": "catalog:expo56",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:expo56",
    "expo-doctor": "catalog:expo56",
    "node-addon-api": "catalog:",
    "node-gyp": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3"
}
