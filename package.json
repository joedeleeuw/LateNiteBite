{
  "name": "latenitebite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-worklets",
        "react-native-svg"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform web",
    "assets": "node scripts/generate-mark.mjs && node scripts/render-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@legendapp/list": "^2.0.19",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "expo": "~56.0.9",
    "expo-constants": "~56.0.17",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.16",
    "expo-router": "~56.2.9",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lightningcss": "1.30.1",
    "lucide-react-native": "^1.17.0",
    "opening_hours": "^3.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "3.0.0",
    "react-native-reanimated": "4.4.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.29.7",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.14",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
